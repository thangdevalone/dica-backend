  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active, updatedAt])
  @@index([organizationId, active])
  @@map("push_devices")
}

model Attachment {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  uploadedById    String       @map("uploaded_by_id") @db.Uuid
  resourceType    String       @map("resource_type") @db.VarChar(30)
  resourceId      String       @map("resource_id") @db.Uuid
  fileName        String       @map("file_name") @db.VarChar(255)
  mimeType        String       @map("mime_type") @db.VarChar(100)
  sizeBytes       Int          @map("size_bytes")
  objectKey       String?      @unique @map("object_key") @db.VarChar(512)
  content         Bytes?
  uploadStatus    String       @default("READY") @map("upload_status") @db.VarChar(20)
  uploadExpiresAt DateTime?    @map("upload_expires_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy      User         @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([organizationId, resourceType, resourceId, createdAt])
  @@index([organizationId, uploadStatus, uploadExpiresAt])
  @@map("attachments")
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  type          String       @db.VarChar(100)
  aggregateType String       @map("aggregate_type") @db.VarChar(100)
  aggregateId   String       @map("aggregate_id") @db.VarChar(100)
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now()) @map("available_at")
  processedAt   DateTime?    @map("processed_at")
  lastError     String?      @map("last_error") @db.VarChar(2000)
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([status, availableAt, createdAt])
  @@map("outbox_events")
}

model PriceRule {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  ingredientId     String   @map("ingredient_id") @db.Uuid
  basePrice        Decimal  @map("base_price") @db.Decimal(20, 4)
  tolerancePercent Decimal  @default(10) @map("tolerance_percent") @db.Decimal(10, 4)
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, ingredientId])
  @@map("price_rules")
}

model ReturnDocument {
  id           String           @id @default(uuid()) @db.Uuid
  orderId      String           @map("order_id") @db.Uuid
  code         String           @unique @db.VarChar(50)
  status       DocumentStatus   @default(DRAFT)
  version      Int              @default(1)
  createdById  String           @map("created_by_id") @db.Uuid
  approvedById String?          @map("approved_by_id") @db.Uuid
  note         String           @db.VarChar(1000)
  decisionNote String?          @map("decision_note") @db.VarChar(1000)
  createdAt    DateTime         @default(now()) @map("created_at")
  approvedAt   DateTime?        @map("approved_at")
  settleAt     DateTime?        @map("settle_at")
  postedAt     DateTime?        @map("posted_at")
  order        FulfillmentOrder @relation(fields: [orderId], references: [id])
  lines        ReturnLine[]

  @@index([status, settleAt])
  @@map("return_documents")
}

model ReturnLine {
  id          String          @id @default(uuid()) @db.Uuid
  returnId    String          @map("return_id") @db.Uuid
  orderLineId String          @map("order_line_id") @db.Uuid
  quantity    Decimal         @db.Decimal(20, 3)
  document    ReturnDocument  @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderLine   FulfillmentLine @relation(fields: [orderLineId], references: [id])

  @@unique([returnId, orderLineId])
  @@map("return_lines")
}
