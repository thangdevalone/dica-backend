generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserKind {
  INTERNAL
  SUPPLIER
}

enum FacilityType {
  CENTRAL_WAREHOUSE
  CENTRAL_KITCHEN
  BRANCH
}

enum StockLocationType {
  PHYSICAL
  IN_TRANSIT
}

enum DepartmentType {
  KITCHEN
  TABLE
  WAREHOUSE
  INVENTORY
  OTHER
}

enum ScopeType {
  ORGANIZATION
  FACILITY
  STOCK_LOCATION
  DEPARTMENT
  OWN
  SUPPLIER
}

enum SourceType {
  STOCK
  SUPPLIER
}

enum DocumentStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum OrderStatus {
  DRAFT
  RELEASED
  PARTIAL
  COMPLETED
  CLOSED
  CANCELLED
}

enum OrderSourceType {
  STOCK
  SUPPLIER
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  AUTO_APPROVED
}

enum DispatchStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum ReceiptStatus {
  DRAFT
  POSTED
  PENDING_EXCESS_REVIEW
  CANCELLED
}

enum DiscrepancyType {
  SHORTAGE
  EXCESS
  DAMAGED
}

enum DiscrepancyStatus {
  OPEN
  RESOLVED
}

enum LedgerEntryType {
  DISPATCH_OUT
  TRANSIT_IN
  TRANSIT_OUT
  RECEIPT_IN
  SUPPLIER_RECEIPT_IN
  ADJUSTMENT
  DAMAGE
  REVERSAL
}

enum AdjustmentStatus {
  DRAFT
  APPROVED
  POSTED
  REJECTED
  CANCELLED
}

enum StocktakeStatus {
  DRAFT
  SUBMITTED
  REOPENED
}

enum DamageStatus {
  DRAFT
  SUBMITTED
  CONFIRMED
  REJECTED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum NotificationStatus {
  UNREAD
  READ
}

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum TransferStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum SalesImportStatus {
  DRAFT
  VALIDATED
  DATA_INCOMPLETE
  COMMITTED
  FAILED
}

enum VarianceDataStatus {
  COMPLETE
  DATA_INCOMPLETE
}

model Organization {
  id                        String             @id @default(uuid()) @db.Uuid
  code                      String             @unique @db.VarChar(50)
  name                      String             @db.VarChar(200)
  active                    Boolean            @default(true)
  createdAt                 DateTime           @default(now()) @map("created_at")
  updatedAt                 DateTime           @updatedAt @map("updated_at")
  paymentApprovalRequired   Boolean            @default(false) @map("payment_approval_required")
  attachmentRetentionMonths Int                @default(12) @map("attachment_retention_months")
  facilities                Facility[]
  users                     User[]
  roles                     Role[]
  ingredients               Ingredient[]
  groups                    IngredientGroup[]
  units                     Unit[]
  suppliers                 Supplier[]
  requests                  SupplyRequest[]
  orders                    FulfillmentOrder[]
  auditEvents               AuditEvent[]
  notifications             Notification[]
  pushDevices               PushDevice[]
  attachments               Attachment[]
  transfers                 Transfer[]
  menuMappings              MenuItemMapping[]
  salesBatches              SalesImportBatch[]
  salesRecords              SalesRecord[]
  variances                 VarianceResult[]
  alertRules                AlertRule[]

  @@map("organizations")
}

model BootstrapState {
  key         String   @id @db.VarChar(100)
  version     Int
  adminUserId String?  @map("admin_user_id") @db.Uuid
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("bootstrap_states")
}

model Facility {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @map("organization_id") @db.Uuid
  code               String             @db.VarChar(50)
  name               String             @db.VarChar(200)
  type               FacilityType
  active             Boolean            @default(true)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  organization       Organization       @relation(fields: [organizationId], references: [id])
  stockLocations     StockLocation[]
  departments        Department[]
  eligibilities      ItemEligibility[]
  groupEligibilities GroupEligibility[]
  sourceRules        SourceRule[]
  requests           SupplyRequest[]
  roleGrants         RoleGrant[]
  menuMappings       MenuItemMapping[]
  salesBatches       SalesImportBatch[]
  alertRules         AlertRule[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
  @@map("facilities")
}

model StockLocation {
  id                String                @id @default(uuid()) @db.Uuid
  facilityId        String                @map("facility_id") @db.Uuid
  code              String                @db.VarChar(50)
  name              String                @db.VarChar(200)
  type              StockLocationType     @default(PHYSICAL)
  active            Boolean               @default(true)
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  facility          Facility              @relation(fields: [facilityId], references: [id])
  departments       Department[]
  grants            RoleGrant[]
  stockBalances     StockBalance[]
  ledgerEntries     StockLedgerEntry[]
  sourceRules       SourceRule[]          @relation("SourceStockLocation")
  destinationOrders FulfillmentOrder[]    @relation("DestinationLocation")
  sourceOrders      FulfillmentOrder[]    @relation("SourceLocation")
  stocktakes        Stocktake[]
  damageReports     DamageReport[]
  transfersFrom     Transfer[]            @relation("TransferFrom")
  transfersTo       Transfer[]            @relation("TransferTo")
  recipeVersions    RecipeVersion[]
  varianceResults   VarianceResult[]
  adjustments       InventoryAdjustment[]

  @@unique([facilityId, code])
  @@index([facilityId, active])
  @@map("stock_locations")
}

model Department {
  id                 String             @id @default(uuid()) @db.Uuid
  facilityId         String             @map("facility_id") @db.Uuid
  stockLocationId    String?            @map("stock_location_id") @db.Uuid
  code               String             @db.VarChar(50)
  name               String             @db.VarChar(200)
  type               DepartmentType
  active             Boolean            @default(true)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  facility           Facility           @relation(fields: [facilityId], references: [id])
  stockLocation      StockLocation?     @relation(fields: [stockLocationId], references: [id])
  grants             RoleGrant[]
  eligibilities      ItemEligibility[]
  groupEligibilities GroupEligibility[]
  requests           SupplyRequest[]

  @@unique([facilityId, code])
  @@index([stockLocationId])
  @@map("departments")
}

model User {
  id                  String          @id @default(uuid()) @db.Uuid
  organizationId      String          @map("organization_id") @db.Uuid
  supplierId          String?         @map("supplier_id") @db.Uuid
  kind                UserKind        @default(INTERNAL)
  username            String          @db.VarChar(100)
  displayName         String          @map("display_name") @db.VarChar(200)
  identityNumber      String?         @map("identity_number") @db.VarChar(20)
  dateOfBirth         DateTime?       @map("date_of_birth") @db.Date
  phone               String?         @db.VarChar(30)
  email               String?         @db.VarChar(254)
  address             String?         @db.VarChar(500)
  passwordHash        String          @map("password_hash")
  active              Boolean         @default(true)
  tokenVersion        Int             @default(0) @map("token_version")
  lastLoginAt         DateTime?       @map("last_login_at")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  organization        Organization    @relation(fields: [organizationId], references: [id])
  supplier            Supplier?       @relation(fields: [supplierId], references: [id])
  sessions            Session[]
  grants              RoleGrant[]
  createdRequests     SupplyRequest[] @relation("RequestCreator")
  auditEvents         AuditEvent[]
  notifications       Notification[]
  pushDevices         PushDevice[]
  uploadedAttachments Attachment[]
  createdTransfers    Transfer[]      @relation("TransferCreator")

  @@unique([organizationId, username])
  @@unique([organizationId, identityNumber])
  @@index([supplierId])
  @@index([organizationId, createdAt, id])
  @@map("users")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  userAgent        String?   @map("user_agent") @db.VarChar(500)
  createdAt        DateTime  @default(now()) @map("created_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("sessions")
}

model Role {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  code           String           @db.VarChar(80)
  name           String           @db.VarChar(150)
  system         Boolean          @default(false)
  active         Boolean          @default(true)
  organization   Organization     @relation(fields: [organizationId], references: [id])
  permissions    RolePermission[]
  grants         RoleGrant[]

  @@unique([organizationId, code])
  @@map("roles")
}

model Permission {
  code        String           @id @db.VarChar(100)
  description String           @db.VarChar(250)
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId         String     @map("role_id") @db.Uuid
  permissionCode String     @map("permission_code") @db.VarChar(100)
  role           Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([roleId, permissionCode])
  @@map("role_permissions")
}

model RoleGrant {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  roleId          String         @map("role_id") @db.Uuid
  scopeType       ScopeType      @map("scope_type")
  facilityId      String?        @map("facility_id") @db.Uuid
  stockLocationId String?        @map("stock_location_id") @db.Uuid
  departmentId    String?        @map("department_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")
  revokedAt       DateTime?      @map("revoked_at")
  user            User           @relation(fields: [userId], references: [id])
  role            Role           @relation(fields: [roleId], references: [id])
  facility        Facility?      @relation(fields: [facilityId], references: [id])
  stockLocation   StockLocation? @relation(fields: [stockLocationId], references: [id])
  department      Department?    @relation(fields: [departmentId], references: [id])

  @@index([userId, revokedAt])
  @@map("role_grants")
}

model IngredientGroup {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  code           String             @db.VarChar(50)
  name           String             @db.VarChar(200)
  active         Boolean            @default(true)
  organization   Organization       @relation(fields: [organizationId], references: [id])
  ingredients    Ingredient[]
  eligibilities  GroupEligibility[]

  @@unique([organizationId, code])
  @@map("ingredient_groups")
}

model Unit {
  id              String                     @id @default(uuid()) @db.Uuid
  organizationId  String                     @map("organization_id") @db.Uuid
  code            String                     @db.VarChar(30)
  name            String                     @db.VarChar(100)
  decimalScale    Int                        @default(3) @map("decimal_scale")
  active          Boolean                    @default(true)
  organization    Organization               @relation(fields: [organizationId], references: [id])
  baseIngredients Ingredient[]
  conversions     IngredientUnitConversion[]

  @@unique([organizationId, code])
  @@map("units")
}

model Ingredient {
  id              String                     @id @default(uuid()) @db.Uuid
  organizationId  String                     @map("organization_id") @db.Uuid
  groupId         String?                    @map("group_id") @db.Uuid
  baseUnitId      String                     @map("base_unit_id") @db.Uuid
  code            String                     @db.VarChar(50)
  name            String                     @db.VarChar(200)
  active          Boolean                    @default(true)
  organization    Organization               @relation(fields: [organizationId], references: [id])
  group           IngredientGroup?           @relation(fields: [groupId], references: [id])
  baseUnit        Unit                       @relation(fields: [baseUnitId], references: [id])
  conversions     IngredientUnitConversion[]
  supplierLinks   SupplierIngredient[]
  eligibilities   ItemEligibility[]
  sourceRules     SourceRule[]
  requestLines    RequestLine[]
  orderLines      FulfillmentLine[]
  balances        StockBalance[]
  ledgerEntries   StockLedgerEntry[]
  transferLines   TransferLine[]
  stocktakeLines  StocktakeLine[]
  damageLines     DamageLine[]
  recipeItems     RecipeIngredient[]
  varianceResults VarianceResult[]
  alertRules      AlertRule[]
  adjustments     InventoryAdjustment[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
  @@map("ingredients")
}

model IngredientUnitConversion {
  id            String     @id @default(uuid()) @db.Uuid
  ingredientId  String     @map("ingredient_id") @db.Uuid
  unitId        String     @map("unit_id") @db.Uuid
  factorToBase  Decimal    @map("factor_to_base") @db.Decimal(20, 6)
  version       Int        @default(1)
  effectiveFrom DateTime   @default(now()) @map("effective_from")
  effectiveTo   DateTime?  @map("effective_to")
  ingredient    Ingredient @relation(fields: [ingredientId], references: [id])
  unit          Unit       @relation(fields: [unitId], references: [id])

  @@unique([ingredientId, unitId, version])
  @@index([ingredientId, effectiveFrom, effectiveTo])
  @@map("ingredient_unit_conversions")
}

model Supplier {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  code           String               @db.VarChar(50)
  name           String               @db.VarChar(200)
  phone          String?              @db.VarChar(30)
  email          String?              @db.VarChar(200)
  active         Boolean              @default(true)
  organization   Organization         @relation(fields: [organizationId], references: [id])
  users          User[]
  ingredients    SupplierIngredient[]
  sourceRules    SourceRule[]
  orders         FulfillmentOrder[]

  @@unique([organizationId, code])
  @@map("suppliers")
}

model SupplierIngredient {
  id             String     @id @default(uuid()) @db.Uuid
  supplierId     String     @map("supplier_id") @db.Uuid
  ingredientId   String     @map("ingredient_id") @db.Uuid
  supplierSku    String?    @map("supplier_sku") @db.VarChar(100)
  referencePrice Decimal?   @map("reference_price") @db.Decimal(20, 4)
  isPreferred    Boolean    @default(false) @map("is_preferred")
  active         Boolean    @default(true)
  supplier       Supplier   @relation(fields: [supplierId], references: [id])
  ingredient     Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([supplierId, ingredientId])
  @@index([ingredientId, isPreferred, active])
  @@map("supplier_ingredients")
}

model ItemEligibility {
  id                    String     @id @default(uuid()) @db.Uuid
  facilityId            String     @map("facility_id") @db.Uuid
  departmentId          String     @map("department_id") @db.Uuid
  ingredientId          String     @map("ingredient_id") @db.Uuid
  maxQuantityPerRequest Decimal?   @map("max_quantity_per_request") @db.Decimal(20, 3)
  active                Boolean    @default(true)
  facility              Facility   @relation(fields: [facilityId], references: [id])
  department            Department @relation(fields: [departmentId], references: [id])
  ingredient            Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([facilityId, departmentId, ingredientId])
  @@map("item_eligibilities")
}

model GroupEligibility {
  id                    String          @id @default(uuid()) @db.Uuid
  facilityId            String          @map("facility_id") @db.Uuid
  departmentId          String          @map("department_id") @db.Uuid
  ingredientGroupId     String          @map("ingredient_group_id") @db.Uuid
  maxQuantityPerRequest Decimal?        @map("max_quantity_per_request") @db.Decimal(20, 3)
  active                Boolean         @default(true)
  facility              Facility        @relation(fields: [facilityId], references: [id])
  department            Department      @relation(fields: [departmentId], references: [id])
  ingredientGroup       IngredientGroup @relation(fields: [ingredientGroupId], references: [id])

  @@unique([facilityId, departmentId, ingredientGroupId])
  @@index([ingredientGroupId, active])
  @@map("group_eligibilities")
}

model SourceRule {
  id                    String               @id @default(uuid()) @db.Uuid
  facilityId            String               @map("facility_id") @db.Uuid
  ingredientId          String               @map("ingredient_id") @db.Uuid
  sourceType            SourceType           @map("source_type")
  sourceStockLocationId String?              @map("source_stock_location_id") @db.Uuid
  supplierId            String?              @map("supplier_id") @db.Uuid
  revision              Int                  @default(1)
  active                Boolean              @default(true)
  effectiveFrom         DateTime             @default(now()) @map("effective_from")
  facility              Facility             @relation(fields: [facilityId], references: [id])
  ingredient            Ingredient           @relation(fields: [ingredientId], references: [id])
  sourceStockLocation   StockLocation?       @relation("SourceStockLocation", fields: [sourceStockLocationId], references: [id])
  supplier              Supplier?            @relation(fields: [supplierId], references: [id])
  revisions             SourceRuleRevision[]

  @@unique([facilityId, ingredientId])
  @@index([facilityId, effectiveFrom, id])
  @@map("source_rules")
}

model SourceRuleRevision {
  id           String     @id @default(uuid()) @db.Uuid
  sourceRuleId String     @map("source_rule_id") @db.Uuid
  revision     Int
  beforeData   Json?      @map("before_data")
  afterData    Json       @map("after_data")
  changedById  String     @map("changed_by_id") @db.Uuid
  changedAt    DateTime   @default(now()) @map("changed_at")
  sourceRule   SourceRule @relation(fields: [sourceRuleId], references: [id])

  @@unique([sourceRuleId, revision])
  @@map("source_rule_revisions")
}

model SupplyRequest {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  facilityId     String             @map("facility_id") @db.Uuid
  departmentId   String             @map("department_id") @db.Uuid
  createdById    String             @map("created_by_id") @db.Uuid
  code           String             @db.VarChar(50)
  status         DocumentStatus     @default(DRAFT)
  requiredDate   DateTime           @map("required_date") @db.Date
  note           String?            @db.VarChar(1000)
  version        Int                @default(1)
  submittedAt    DateTime?          @map("submitted_at")
  decidedAt      DateTime?          @map("decided_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  organization   Organization       @relation(fields: [organizationId], references: [id])
  facility       Facility           @relation(fields: [facilityId], references: [id])
  department     Department         @relation(fields: [departmentId], references: [id])
  createdBy      User               @relation("RequestCreator", fields: [createdById], references: [id])
  lines          RequestLine[]
  approvals      ApprovalEvent[]
  orders         FulfillmentOrder[]

  @@unique([organizationId, code])
  @@index([organizationId, facilityId, status])
  @@index([organizationId, createdAt, id])
  @@index([organizationId, departmentId, createdAt, id])
  @@index([organizationId, createdById, createdAt, id])
  @@map("supply_requests")
}

model Transfer {
  id                   String                  @id @default(uuid()) @db.Uuid
  organizationId       String                  @map("organization_id") @db.Uuid
  code                 String                  @db.VarChar(50)
  fromStockLocationId  String                  @map("from_stock_location_id") @db.Uuid
  toStockLocationId    String                  @map("to_stock_location_id") @db.Uuid
  createdById          String                  @map("created_by_id") @db.Uuid
  status               TransferStatus          @default(DRAFT)
  version              Int                     @default(1)
  note                 String?                 @db.VarChar(1000)
  expectedArrivalAt    DateTime?               @map("expected_arrival_at")
  expectedArrivalEndAt DateTime?               @map("expected_arrival_end_at")
  submittedAt          DateTime?               @map("submitted_at")
  decidedAt            DateTime?               @map("decided_at")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")
  organization         Organization            @relation(fields: [organizationId], references: [id])
  fromStockLocation    StockLocation           @relation("TransferFrom", fields: [fromStockLocationId], references: [id])
  toStockLocation      StockLocation           @relation("TransferTo", fields: [toStockLocationId], references: [id])
  createdBy            User                    @relation("TransferCreator", fields: [createdById], references: [id])
  lines                TransferLine[]
  approvals            TransferApprovalEvent[]
  orders               FulfillmentOrder[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, createdAt, id])
  @@index([organizationId, fromStockLocationId, createdAt, id])
  @@index([organizationId, toStockLocationId, createdAt, id])
  @@index([createdById, createdAt, id])
  @@map("transfers")
}

model TransferLine {
  id                     String            @id @default(uuid()) @db.Uuid
  transferId             String            @map("transfer_id") @db.Uuid
  ingredientId           String            @map("ingredient_id") @db.Uuid
  quantity               Decimal           @db.Decimal(20, 3)
  ingredientNameSnapshot String            @map("ingredient_name_snapshot") @db.VarChar(200)
  unitCodeSnapshot       String            @map("unit_code_snapshot") @db.VarChar(30)
  transfer               Transfer          @relation(fields: [transferId], references: [id], onDelete: Cascade)
  ingredient             Ingredient        @relation(fields: [ingredientId], references: [id])
  orderLines             FulfillmentLine[]

  @@unique([transferId, ingredientId])
  @@map("transfer_lines")
}

model TransferApprovalEvent {
  id         String           @id @default(uuid()) @db.Uuid
  transferId String           @map("transfer_id") @db.Uuid
  actorId    String           @map("actor_id") @db.Uuid
  decision   ApprovalDecision
  policy     String           @db.VarChar(100)
  note       String?          @db.VarChar(1000)
  createdAt  DateTime         @default(now()) @map("created_at")
  transfer   Transfer         @relation(fields: [transferId], references: [id])

  @@index([transferId, createdAt])
  @@map("transfer_approval_events")
}

model RequestLine {
  id                       String            @id @default(uuid()) @db.Uuid
  requestId                String            @map("request_id") @db.Uuid
  ingredientId             String            @map("ingredient_id") @db.Uuid
  requestedUnitId          String            @map("requested_unit_id") @db.Uuid
  requestedQuantity        Decimal           @map("requested_quantity") @db.Decimal(20, 3)
  baseQuantity             Decimal           @map("base_quantity") @db.Decimal(20, 3)
  ingredientNameSnapshot   String            @map("ingredient_name_snapshot") @db.VarChar(200)
  unitCodeSnapshot         String            @map("unit_code_snapshot") @db.VarChar(30)
  conversionFactorSnapshot Decimal           @map("conversion_factor_snapshot") @db.Decimal(20, 6)
  sourceTypeSnapshot       SourceType?       @map("source_type_snapshot")
  sourceRuleRevision       Int?              @map("source_rule_revision")
  sourceStockLocationId    String?           @map("source_stock_location_id") @db.Uuid
  supplierId               String?           @map("supplier_id") @db.Uuid
  request                  SupplyRequest     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  ingredient               Ingredient        @relation(fields: [ingredientId], references: [id])
  orderLines               FulfillmentLine[]

  @@unique([requestId, ingredientId])
  @@map("request_lines")
}

model ApprovalEvent {
  id        String           @id @default(uuid()) @db.Uuid
  requestId String           @map("request_id") @db.Uuid
  actorId   String           @map("actor_id") @db.Uuid
  decision  ApprovalDecision
  policy    String           @db.VarChar(100)
  note      String?          @db.VarChar(1000)
  createdAt DateTime         @default(now()) @map("created_at")
  request   SupplyRequest    @relation(fields: [requestId], references: [id])

  @@index([requestId, createdAt])
  @@map("approval_events")
}

model FulfillmentOrder {
  id                         String            @id @default(uuid()) @db.Uuid
  organizationId             String            @map("organization_id") @db.Uuid
