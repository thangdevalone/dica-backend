# Image do GitHub Actions push lên GHCR. Khi deploy tự động, workflow sẽ ghi đè
# biến này bằng image@sha256:digest bất biến.
APP_IMAGE=ghcr.io/your-github-owner/dica-backend:latest
APP_PULL_POLICY=always
APP_PORT=3000

# Dùng mật khẩu dạng hex để có thể đặt trực tiếp trong DATABASE_URL.
# Tạo bằng: openssl rand -hex 32
POSTGRES_DB=dica
POSTGRES_USER=dica
POSTGRES_PASSWORD=replace-with-a-random-hex-password
DATABASE_URL=postgresql://dica:replace-with-a-random-hex-password@postgres:5432/dica?schema=public

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-at-least-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Domain frontend thật, phân tách bằng dấu phẩy nếu có nhiều origin.
CORS_ORIGINS=https://app.example.com
HTTP_BODY_LIMIT=10mb
TRUST_PROXY_HOPS=1
SWAGGER_ENABLED=false
LOG_LEVEL=info

DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_TRANSACTION_TIMEOUT_MS=15000
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_TRANSACTION_TIMEOUT_MS=30000
DEMO_POLICY_ENABLED=false
