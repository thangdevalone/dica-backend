# Image backend. GitHub Actions sẽ ghi đè APP_IMAGE bằng image digest khi deploy CI.
APP_IMAGE=ghcr.io/thangdevalone/dica-backend:latest
APP_PULL_POLICY=always
APP_PORT=3000

# PostgreSQL trong docker-compose.yml.
# Dùng cùng một mật khẩu ở POSTGRES_PASSWORD và phần password của DATABASE_URL.
# Nên dùng chuỗi hex để không phải URL-encode ký tự đặc biệt.
POSTGRES_DB=dica
POSTGRES_USER=dica
POSTGRES_PASSWORD=replace-with-a-random-hex-password
DATABASE_URL=postgresql://dica:replace-with-a-random-hex-password@postgres:5432/dica?schema=public

# Application
LOG_LEVEL=info
CORS_ORIGINS=https://admin.example.com
HTTP_BODY_LIMIT=10mb
TRUST_PROXY_HOPS=1
SWAGGER_ENABLED=false
DEMO_POLICY_ENABLED=false

# Cloudflare R2 private bucket. Do not expose this bucket publicly.
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET=dica-attachments
R2_UPLOAD_URL_TTL_SECONDS=600
R2_VIEW_URL_TTL_SECONDS=300

# JWT: hai giá trị phải khác nhau và mỗi giá trị dài ít nhất 32 ký tự.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-at-least-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Database limits
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_TRANSACTION_TIMEOUT_MS=15000
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_TRANSACTION_TIMEOUT_MS=30000

# Tài khoản quản trị được tạo ở lần bootstrap đầu tiên.
# Mật khẩu dài 12-200 ký tự và không được chứa từ "replace".
BOOTSTRAP_ORGANIZATION_CODE=DICA
BOOTSTRAP_ORGANIZATION_NAME=DICA
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_DISPLAY_NAME=Quản trị DICA
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-initial-admin-password

# Firebase Cloud Messaging cho Android và iOS.
# Giữ false cho tới khi đã cấu hình service account và APNs trong Firebase Console.
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Khi bật FCM, đặt private_key trên một dòng và giữ nguyên các ký tự \n.
FCM_PRIVATE_KEY=
FCM_ANDROID_CHANNEL_ID=dica_operations
