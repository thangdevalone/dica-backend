# Image do GitHub Actions push lên GHCR. Khi deploy tự động, workflow sẽ ghi đè
# biến này bằng image@sha256:digest bất biến.
APP_IMAGE=ghcr.io/thangdevalone/dica-backend:latest
APP_PULL_POLICY=always
APP_PORT=3000

# Image frontend DICA Web
WEB_IMAGE=ghcr.io/thangdevalone/dica-web:latest
WEB_PULL_POLICY=always
WEB_PORT=3001

# Dùng mật khẩu dạng hex để có thể đặt trực tiếp trong DATABASE_URL.
# Tạo bằng: openssl rand -hex 32
POSTGRES_DB=dica
POSTGRES_USER=dica
POSTGRES_PASSWORD=replace-with-a-random-hex-password
DATABASE_URL=postgresql://dica:replace-with-a-random-hex-password@postgres:5432/dica?schema=public

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-at-least-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Chỉ bắt buộc ở lần bootstrap đầu tiên. Sau khi deploy thành công có thể xoá password này;
# các lần nâng version role/permission không ghi đè mật khẩu admin đã đổi trong ứng dụng.
BOOTSTRAP_ORGANIZATION_CODE=DICA
BOOTSTRAP_ORGANIZATION_NAME=DICA
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_DISPLAY_NAME=Quản trị DICA
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-initial-admin-password

# Cho phép tất cả các domain gọi tới API (hoặc chỉ định cụ thể phân tách bằng dấu phẩy)
CORS_ORIGINS=*
HTTP_BODY_LIMIT=10mb
TRUST_PROXY_HOPS=1
SWAGGER_ENABLED=false
LOG_LEVEL=info

DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_TRANSACTION_TIMEOUT_MS=15000
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_TRANSACTION_TIMEOUT_MS=30000
DEMO_POLICY_ENABLED=false

# Firebase Cloud Messaging HTTP v1 (Android + iOS). Keep false until configured.
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Paste private_key from the Firebase service-account JSON on one line; keep \n escapes.
FCM_PRIVATE_KEY=
FCM_ANDROID_CHANNEL_ID=dica_operations
