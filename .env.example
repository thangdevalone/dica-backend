NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
DATABASE_URL=postgresql://dica:dica_dev_password@localhost:5432/dica?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-at-least-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGINS=http://localhost:3001,http://localhost:5173
HTTP_BODY_LIMIT=10mb
TRUST_PROXY_HOPS=0
SWAGGER_ENABLED=false
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_TRANSACTION_TIMEOUT_MS=15000
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_TRANSACTION_TIMEOUT_MS=30000
DEMO_POLICY_ENABLED=false

# Firebase Cloud Messaging HTTP v1 (Android + iOS). Keep false until configured.
# iOS: upload the APNs .p8 key, Key ID and Apple Team ID in Firebase Console.
# Keep GoogleService-Info.plist, google-services.json and the APNs key out of backend env.
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Paste private_key from the Firebase service-account JSON on one line; keep \n escapes.
FCM_PRIVATE_KEY=
FCM_ANDROID_CHANNEL_ID=dica_operations
# Dùng chung cho bootstrap production và seed dữ liệu demo/local.
BOOTSTRAP_ORGANIZATION_CODE=DICA
BOOTSTRAP_ORGANIZATION_NAME=DICA Demo
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_DISPLAY_NAME=Quản trị DICA
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-initial-admin-password
