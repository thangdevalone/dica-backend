NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
DATABASE_URL=postgresql://dica:dica_dev_password@localhost:5432/dica?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-at-least-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGINS=http://localhost:3001,http://localhost:5173
HTTP_BODY_LIMIT=10mb
SWAGGER_ENABLED=false
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_TRANSACTION_TIMEOUT_MS=15000
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_TRANSACTION_TIMEOUT_MS=30000
DEMO_POLICY_ENABLED=false
DEFAULT_ORGANIZATION_CODE=DICA
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace-this-before-seeding
